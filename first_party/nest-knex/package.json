{
  "name": "@indiebase/nest-knex",
  "version": "0.0.1",
  "description": "Nestjs knex module for Indiebase",
  "author": "Han",
  "private": true,
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./extend": "./src/extend.d.ts",
    "./ex": "./src/knex.ex.ts"
  },
  "scripts": {
    "prebuild": "shx rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "11.0.9",
    "@nestjs/core": "11.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.9",
    "@types/express": "5.0.0",
    "@types/node": "22.13.1",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  },
  "peerDependencies": {
    "knex": "3.1.0"
  }
}
