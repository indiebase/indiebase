{
  "name": "knex-hydration",
  "version": "0.0.1-alpha.11",
  "description": "Takes knex query return nested object with types using NestHydration.",
  "author": "Han <deskbtm@outlook.com>",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist&& tsc",
    "prepack": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "files": [
    "dist/**/*",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "repository": {
    "url": "https://github.com/indiebase/indiebase",
    "directory": "first_party/gadgets",
    "type": "git"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "shx": "0.3.4",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "nesthydrationjs": "2.0.0"
  }
}
