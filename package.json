{
  "name": "indiebase",
  "version": "0.0.2-alpha.0",
  "description": "A self-hosted platform explicitly designed for indie hackers or teams. Providing BaaS and Close Collective services.",
  "author": "Han <han@deskbtm.com>",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "yarn": ">2.0.0",
    "node": ">=20.0.0",
    "npm": "please-use-yarn",
    "pnpm": "please-use-yarn"
  },
  "scripts": {
    "start:community": "yarn workspace @indiebase/community start",
    "start:app": "yarn workspace @indiebase/app start",
    "start:docs": "yarn workspace @indiebase/docs start",
    "lint": "eslint . --fix",
    "_stack:deploy": "docker stack deploy -c ./docker-compose.yaml indiebase",
    "preset:prod": "docker stack deploy -c ./docker-compose.yaml -c ./docker-compose.production.yaml indiebase",
    "preset:dev": "dotenv -e .env -- yarn _stack:deploy",
    "release": "standard-version",
    "prepare": "husky install",
    "syncpack": "syncpack",
    "mismatches": "syncpack list-mismatches",
    "util:paseto:key": "node ./scripts/paseto.mjs",
    "eslint-inspector": "eslint-config-inspector",
    "prettier": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/compat": "1.2.3",
    "@eslint/config-inspector": "0.5.6",
    "@next/eslint-plugin-next": "15.0.3",
    "@types/eslint-plugin-security": "^3.0.0",
    "@typescript-eslint/parser": "8.16.0",
    "@vitest/ui": "2.1.6",
    "cross-env": "7.0.3",
    "cz-conventional-changelog": "3.3.0",
    "dotenv-cli": "7.4.4",
    "eslint": "9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.12.0",
    "husky": "9.1.7",
    "prettier": "3.4.1",
    "shx": "0.3.4",
    "standard-version": "9.5.0",
    "syncpack": "13.0.0",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "workspaces": {
    "packages": [
      "first_party/*",
      "apps/*",
      "apps/first_party/*",
      "apps/packages/*",
      "community",
      "pro/*",
      "packages/*"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@4.4.0",
  "dependencies": {
    "@deskbtm/gadgets": "workspace:^",
    "knex-hydration": "workspace:^",
    "type-fest": "4.29.0"
  }
}
