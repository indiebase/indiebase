{
  "name": "indiebase",
  "version": "0.0.2-alpha.0",
  "description": "",
  "author": "Han",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "yarn": ">2.0.0",
    "node": ">=20.0.0",
    "npm": "please-use-yarn",
    "pnpm": "please-use-yarn"
  },
  "scripts": {
    "start:community": "yarn workspace @indiebase/community start",
    "start:app": "yarn workspace @indiebase/app start",
    "start:docs": "yarn workspace @indiebase/docs start",
    "lint": "eslint . --fix",
    "_stack:deploy": "docker stack deploy -c ./docker-compose.yaml indiebase",
    "preset:prod": "docker stack deploy -c ./docker-compose.yaml -c ./docker-compose.production.yaml indiebase",
    "preset:dev": "dotenv -e .env -- yarn _stack:deploy",
    "release": "standard-version",
    "prepare": "husky install",
    "syncpack": "syncpack",
    "mismatches": "syncpack list-mismatches",
    "util:paseto:key": "node ./scripts/paseto.mjs",
    "eslint-inspector": "eslint-config-inspector"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@eslint/config-inspector": "0.5.1",
    "@next/eslint-plugin-next": "14.2.4",
    "@typescript-eslint/parser": "7.13.1",
    "@vitest/ui": "1.6.0",
    "cross-env": "7.0.3",
    "cz-conventional-changelog": "3.3.0",
    "dotenv-cli": "7.4.2",
    "eslint": "9.5.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "7.34.3",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "eslint-plugin-simple-import-sort": "12.1.0",
    "globals": "15.6.0",
    "husky": "9.0.11",
    "prettier": "3.2.5",
    "shx": "0.3.4",
    "standard-version": "9.5.0",
    "syncpack": "12.3.2",
    "typescript": "5.5.3",
    "typescript-eslint": "7.15.0"
  },
  "workspaces": {
    "packages": [
      "first_party/*",
      "apps/*",
      "apps/first_party/*",
      "apps/packages/*",
      "community",
      "pro/*",
      "packages/*"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@4.2.2",
  "dependencies": {
    "@deskbtm/gadgets": "workspace:^",
    "type-fest": "4.20.1"
  }
}
