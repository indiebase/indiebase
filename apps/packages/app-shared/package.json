{
  "name": "@indiebase/app-shared",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "default": "./src/*"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "dist/index.js"
  },
  "dependencies": {
    "@indiebase/sdk": "workspace:^",
    "@indiebase/trait": "workspace:^",
    "node-forge": "1.3.1",
    "react-easy-crop": "5.4.2",
    "reactgets": "0.0.1-alpha.4",
    "stegcloak": "1.1.1"
  },
  "devDependencies": {
    "@mantine/core": "8.1.0",
    "@mantine/form": "8.1.0",
    "@mantine/hooks": "8.1.0",
    "@types/node": "24.0.0",
    "@types/node-forge": "1.3.11",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "@types/stegcloak": "1.0.2"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "test": "node scripts/test.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix"
  }
}
