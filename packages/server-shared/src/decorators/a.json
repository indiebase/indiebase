  "components": {
    "schemas": {
      "PaginatedResponseSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total items"
          },
          "pageIndex": {
            "type": "number",
            "description": "Current page"
          },
          "pageSize": {
            "type": "number",
            "description": "Page size"
          },
          "lastPage": {
            "type": "number",
            "description": "Last page"
          },
          "prevPage": {
            "type": "number",
            "description": "Previous page"
          },
          "nextPage": {
            "type": "number",
            "description": "Next page"
          },
          "code": {
            "type": "number",
            "description": "Response logical code",
            "default": 1
          },
          "message": {
            "type": "object",
            "description": "Response message"
          }
        },
        "required": [
          "total",
          "pageIndex",
          "pageSize",
          "lastPage",
          "prevPage",
          "nextPage",
          "code"
        ]
      },
      "FileDTO": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "File location"
          }
        },
        "required": [
          "url"
        ]
      }
    }
