{
  "name": "@indiebase/community",
  "version": "0.0.1",
  "description": "Indiebase community edition",
  "author": "Han",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "demo": "cross-env NODE_ENV=development rspack build",
    "prebuild": "shx rm -rf dist",
    "docker:prod": "npm run bundle && docker build --build-arg RUNTIME_ENV=production -t indiebase/community.",
    "docker:local": "npm run bundle && docker build --build-arg RUNTIME_ENV=local --no-cache -t indiebase/community-local .",
    "build": "shx rm -r build && tsc -b --clean && tsc -b -p ./tsconfig.build.json",
    "start": "cross-env NODE_ENV=development DEBUG=\"ioredis:*\" webpack --config webpack.config.js --watch",
    "preview:dev": "cross-env NODE_ENV=development node ./build/index.js",
    "bundle": "shx rm -rf dist&& ncc build ./src/main.ts -o dist -m",
    "bundle:dev": "shx rm -rf dist&& ncc build ./src/main.ts -o dist -s",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "paseto:key": "node ./scripts/paseto.mjs"
  },
  "dependencies": {
    "@aws-sdk/lib-storage": "3.701.0",
    "@aws-sdk/s3-request-presigner": "3.701.0",
    "@fastify/cookie": "9.4.0",
    "@fastify/helmet": "11.1.1",
    "@fastify/multipart": "8.3.0",
    "@fastify/passport": "2.5.0",
    "@fastify/session": "10.9.0",
    "@fastify/swagger": "8.15.0",
    "@indiebase/nest-accesscontrol": "workspace:^",
    "@indiebase/nest-async-context": "workspace:^",
    "@indiebase/nest-docker": "workspace:^",
    "@indiebase/nest-fastify-passport": "workspace:^",
    "@indiebase/nest-knex": "workspace:^",
    "@indiebase/nest-octokit": "workspace:^",
    "@indiebase/nest-s3": "workspace:^",
    "@indiebase/nest-stoplight-elements": "workspace:^",
    "@indiebase/nestjs-redis": "10.0.0",
    "@indiebase/sdk": "workspace:^",
    "@indiebase/server-shared": "workspace:^",
    "@indiebase/trait": "workspace:^",
    "@indiebase/transactional": "workspace:^",
    "@nestjs-modules/mailer": "2.0.2",
    "@nestjs/axios": "3.1.2",
    "@nestjs/common": "10.4.10",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.10",
    "@nestjs/platform-fastify": "10.4.10",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/terminus": "10.2.3",
    "@react-email/render": "1.0.2",
    "@rspack/cli": "1.1.4",
    "@rspack/core": "1.1.4",
    "@superfaceai/passport-twitter-oauth2": "1.2.4",
    "@total-typescript/ts-reset": "0.6.1",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "class-validator-extended": "4.0.1",
    "dayjs": "1.11.13",
    "fastify": "5.1.0",
    "hyperid": "3.3.0",
    "ioredis": "5.4.1",
    "knex": "3.1.0",
    "ms": "2.1.3",
    "nest-winston": "1.10.0",
    "nestjs-i18n": "10.5.0",
    "nestjs-paseto": "workspace:^",
    "otplib": "12.0.1",
    "passport-apple": "2.0.2",
    "passport-facebook": "3.0.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "passport-local": "1.0.0",
    "passport-microsoft": "2.1.0",
