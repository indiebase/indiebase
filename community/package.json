    "@types/supertest": "6.0.2",
    "@vercel/ncc": "0.38.3",
    "@vitest/coverage-v8": "2.1.6",
    "cross-env": "7.0.3",
    "nodemon": "3.1.7",
    "prettier": "3.4.1",
    "supertest": "7.0.0",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.6",
    "webpack": "5.96.1",
    "webpack-cli": "5.1.4"
  }
}
