{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "removeComments": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "specs/**/*.spec.ts",
    "vitest.config.ts"
